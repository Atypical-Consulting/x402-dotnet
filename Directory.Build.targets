<Project>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)nuget-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- `dotnet pack` fails on a breaking API change against the baseline package on nuget.org. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- The last version published to nuget.org. Bump by hand after each release — see
         CONTRIBUTING.md "Releasing". Deliberately not driven by release-please: its marker would
         write the new, not-yet-published version, which pack cannot restore as a baseline. -->
    <PackageValidationBaselineVersion>0.1.2</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
