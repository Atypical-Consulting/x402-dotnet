<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Version und InformationalVersion sind pilotées par release-please (tâche 18).
       Ne pas les éditer à la main, ne pas retirer les marqueurs x-release-please-version. -->
  <PropertyGroup>
    <Version>0.1.0</Version> <!-- x-release-please-version -->
    <InformationalVersion>0.1.0</InformationalVersion> <!-- x-release-please-version -->
    <Authors>Philippe Matray</Authors>
    <Company>Atypical Consulting</Company>
    <Copyright>Copyright (c) 2026 Atypical Consulting / Philippe Matray</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Atypical-Consulting/x402-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Atypical-Consulting/x402-dotnet</PackageProjectUrl>
    <PackageTags>x402;payments;stablecoin;eurc;usdc;micropayments;base;eip3009;aspnetcore</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
