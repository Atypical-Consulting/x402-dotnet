<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The bare `X402.Core` id belongs to another author on nuget.org (owner `mailpost`,
         github.com/michielpost/x402-dotnet). Namespaces and assembly names are deliberately
         NOT renamed — only the distribution identity is. See ADR 0004. -->
    <PackageId>Atypical.X402.Core</PackageId>
    <RootNamespace>X402</RootNamespace>
    <Description>Core types, JSON contracts, transport codec and verified EURC/USDC asset profiles for the x402 v2 payment protocol. No ASP.NET Core, signing or network dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
