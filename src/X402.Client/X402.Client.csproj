<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- See ADR 0004: the bare `X402.Client` id belongs to another author on nuget.org. -->
    <PackageId>Atypical.X402.Client</PackageId>
    <RootNamespace>X402.Client</RootNamespace>
    <Description>Pay for x402 v2 requests from .NET: a DelegatingHandler that answers HTTP 402 by signing an EIP-3009 transferWithAuthorization and replaying the request, with per-asset spending limits (EURC and USDC never share a cap).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Nethereum.Signer.EIP712" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\X402.Core\X402.Core.csproj" />
  </ItemGroup>

</Project>
