<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- `X402.AspNetCore` is the one id in the family still unclaimed on nuget.org, but the three
         are renamed together: shipping one bare id next to two prefixed ones would be incoherent,
         and the bare id is exactly what an accidental release would have squatted. See ADR 0004. -->
    <PackageId>Atypical.X402.AspNetCore</PackageId>
    <RootNamespace>X402.AspNetCore</RootNamespace>
    <Description>Accept x402 v2 payments in ASP.NET Core: route-pricing middleware, an imperative payment gate for request-dependent prices, a resilient facilitator client, an idempotency ledger that settles each authorization at most once, and start-up validation. Never holds a signing key.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\X402.Core\X402.Core.csproj" />
  </ItemGroup>

</Project>
