{{!The documentation's only layout. It shares the landing page's stylesheet, script, header and
footer (site/style.css, site/site.js, site/index.html), which sit one level above the docs root
once scripts/build-site.sh assembles the site, so _rel followed by ../ is always the site root.}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} · x402-dotnet</title>
{{#description}}<meta name="description" content="{{description}}">{{/description}}
<meta name="theme-color" content="#2b59f5">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%232b59f5'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='900' font-size='15' text-anchor='middle' fill='white'%3E402%3C/text%3E%3C/svg%3E">
<link rel="preload" href="{{_rel}}../fonts/archivo-800.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{_rel}}../fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{_rel}}../style.css">
<script type="module" src="{{_rel}}../site.js"></script>
</head>
<body class="docs">
<a class="skip" href="#main">Skip to content</a>

<header class="top">
  <div class="wrap">
    <a class="brand" href="{{_rel}}../">x402-dotnet</a>
