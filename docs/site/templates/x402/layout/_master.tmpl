      <a class="keep" href="{{_rel}}api/index.html">API</a>
      <a class="gh" href="https://github.com/Atypical-Consulting/x402-dotnet">GitHub</a>
    </nav>
  </div>
</header>

<div class="wrap doc">
  <details class="rail-toggle">
    <summary>Contents</summary>
    <nav class="rail" aria-label="Documentation">
      <p class="rail-pkg">Guides</p>
      <ul class="rail-guides">
        <li><a href="{{_rel}}guides/getting-started.html">Getting started</a></li>
